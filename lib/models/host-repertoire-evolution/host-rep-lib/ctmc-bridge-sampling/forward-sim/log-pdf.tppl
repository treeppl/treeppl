import "../../container-types.tppl"

function ctmcForwardLogPdf(
  startState: Int,
  finalState: Int,
  startAge: Real,
  finalAge: Real,
  eventSeq: Event[],
  embeddedQMatrix: EmbeddedMarkovChainMatrix
) => Real {
  return ctmcForwardDensityRec(
    1, startState, finalState, startAge, finalAge, eventSeq, embeddedQMatrix
  );
}

function ctmcForwardDensityRec(
  nextIndex: Int,
  currState: Int,
  finalState: Int,
  currAge: Real,
  finalAge: Real,
  eventSeq: Event[],
  embeddedQMatrix: EmbeddedMarkovChainMatrix
) => Real {
  if nextIndex > length(eventSeq) {
    let timePassed = currAge - finalAge;
    let outRate = embeddedQMatrix.totalRates[currState + 1];
    return -timePassed * outRate;
  } else {
    let nextEvent = eventSeq[nextIndex];
    let nextState = nextEvent.toState;
    let nextAge = nextEvent.eventTime;
    let timePassed = currAge - nextAge;
    let outRate = embeddedQMatrix.totalRates[currState + 1];
    let thisRate = mtxGet(currState + 1, nextState + 1, embeddedQMatrix.qMatrix);
    return log(thisRate) - timePassed * outRate + ctmcForwardDensityRec(
      nextIndex + 1,
      nextState,
      finalState,
      nextAge,
      finalAge,
      eventSeq,
      embeddedQMatrix
    );
  }
}
