/*
 * Types shared by the host repertoire models
 */ 

// Input tree with labels 
type TreeLabeled =
  | Leaf{age: Real, label: Int}
  | Node{age: Real, left: TreeLabeled, right: TreeLabeled, label: Int}

// The node repertoire embellished with extra stuff for custom graph inference
type NodeRepertoire = NodeRepertoire {
  label : Int,
  parent : Int,
  age : Real,
  repertoire : Int[],
  branchKernel : Real[][]
}

// The return type of every method
type ReturnType = ReturnType {
  mu : Real,
  beta : Real,
  lambda : Real[],
  nodeHistories : NodeRepertoire[]
}
  
// The result from postorder message passing
type MsgTree =
  | MsgLeaf{
    age: Real, label: Int, outMsg: Matrix[Real], interactions: Int[]
  }
  | MsgNode{
    age: Real, label: Int,
    left: MsgTree, right: MsgTree,
    leftInMsg: Matrix[Real], rightInMsg: Matrix[Real],
    leftKernel: Matrix[Real], rightKernel: Matrix[Real],
    outMsg: Matrix[Real]
  }

// A single event in a host
type Event = Event {eventTime: Real, fromState: Int, toState: Int, host: Int}

// A chain of events for a single host
type BridgeWithDensity = BridgeWithDensity {
  bridge: Event[],
  logPdf: Real 
}

// Events for all hosts and the likelihood ratio
type WeightedBranchSample = WeightedBranchSample {
  history: Event[],
  logSamplingDensity: Real,
  logModelDensity: Real
}

// Model parameters as given
type ModelParams = ModelParams {
  beta: Real,
  hostMetric: Matrix[Real],
  embeddedQMatrix: EmbeddedMarkovChainMatrix
}

type GlobalParams = GlobalParams {
  mu: Real,
  beta: Real,
  lambda: Real[]
}

type EmbeddedMarkovChainMatrix = EmbeddedMarkovChainMatrix {
  totalRates: Real[],
  transitionProbs: Real[][],
  qMatrix: Matrix[Real],
  params: GlobalParams
}
