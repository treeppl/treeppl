import "container-types.tppl"
import "lib.tppl"
import "special-mtxExp.tppl"

// Compute postorder messages on the observed tree
// As we have a closed form solution to the matrix exponential 
// in terms of the global parameters (we ignore the special case of 
// a non-diagonalizable matrix which almost surely never happens).
// This is faster and more exact than the squaring and scaling algorithm
function postorderTraverse(
  tree: TreeLabeled, params: GlobalParams, interactions: Int[][], nHosts: Int
) => MsgTree {
  if tree is Leaf {
    let outmsg = observationMessage(interactions[tree.label]);
    let leafInts = interactions[tree.label];
    return MsgLeaf{
      age = 0.0,
      label = tree.label,
      outMsg = observationMessage(leafInts),
      interactions = leafInts
    };
  }

  let left = postorderTraverse(tree.left, params, interactions, nHosts);
  let right = postorderTraverse(tree.right, params, interactions, nHosts);

    // These will be used when we propagate messages in the forward pass later
  let leftKernel = independenceMtxExp(tree.age-left.age, params);
  let rightKernel = independenceMtxExp(tree.age-right.age, params);

  // We are doing the backward pass, so we should transpose the kernels
  let leftBackwardKernel = mtxTrans(leftKernel);
  let rightBackwardKernel = mtxTrans(rightKernel);

  let leftInMsg = mtxMul(left.outMsg, leftBackwardKernel);
  let rightInMsg = mtxMul(right.outMsg, rightBackwardKernel);

  let outMsg = mtxElemMul(leftInMsg, rightInMsg);

  return MsgNode{
    age = tree.age, label = tree.label,
    left = left, right = right, 
    leftInMsg = leftInMsg, rightInMsg = rightInMsg,
    leftKernel = leftKernel, rightKernel = rightKernel, 
    outMsg = outMsg
  };
}

function observationMessage(obsRepertoire: Int[]) => Matrix[Real] {
  return mtxCreate(length(obsRepertoire), 3, paste0(sapply(obsRepertoire, makeStateMessage)));
}

function makeStateMessage(interaction: Int) => Real[] {
  if interaction >= 0 && interaction <= 2 {
    return kroneckerDelta(interaction + 1, 3);
  } else {
    return rep(3, 1.);
  }
}
