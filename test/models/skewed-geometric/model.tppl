// A reweighted geometric distribution written recursively:
// We generate recursively a sample from Geom(q), and accumulate
// likelihood ratio weights such that the normalized sample
// is from Geom(p)
//
// This tests whether inference works for recursive models

model function wgeom() => Int {
  let q = 3. / 4.;
  let p = 1. / 2.;
  assume flip ~ Bernoulli(q) drift Bernoulli(p);
  return manyCoins(p, q, flip);
}

function manyCoins(p : Real, q : Real, flip : Bool) => Int {
  if flip {
    weight p / q;
    assume flip ~ Bernoulli(q) drift Bernoulli(p);
    return 1 + manyCoins(p, q, flip);
  } else {
    return 1;
  }
}
